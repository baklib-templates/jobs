{% comment %}
  Breadcrumb navigation
  Variables:
  - breadcrumb: breadcrumb list data
  - current: current page
{% endcomment %}

<div class="breadcrumbs text-sm flex justify-end">
  <ul>
    {% for item in breadcrumb %}
      <li class="{% if forloop.last %}text-primary{% else %}text-base-content/60{% endif %}">
        {% if forloop.last %}
          <span class="text-primary">Content</span>
        {% else %}
          {% if item.path %}
            <a href="{{ item.path }}">{{ item.link_text }}</a>
          {% else %}
            {{ item.link_text }}
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>