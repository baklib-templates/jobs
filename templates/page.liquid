{%- assign job_title = page.ext_info.title | default: page.link_text -%}
{%- assign summary = page.ext_info.summary | default: page.settings.description -%}
{%- assign location = page.settings.location | default: page.ext_info.location -%}
{%- assign salary = page.settings.salary | default: page.ext_info.salary -%}
{%- assign employment_type = page.settings.employment_type | default: page.ext_info.employment_type -%}
{%- assign workplace_mode = page.settings.workplace_mode.value | default: page.ext_info.workplace_mode -%}
{%- assign posted_at = page.ext_info.date_posted | default: page.published_at | default: page.created_at -%}
{%- assign apply_label = 'templates.page.apply_now' | t -%}
{%- assign skill_tags_raw = page.settings.skill_tags | default: '' -%}
{%- assign skill_tags = skill_tags_raw | newline_to_br | split: '<br />' -%}
{%- assign siblings = page.parent.children_in_list | order_by: '-published_at' -%}

<main class="grow">
  <section class="bg-base-200/60 py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-5">
        {% render 'breadcrumb', breadcrumb: page.breadcrumb, current: page %}
      </div>
      <h1 class="max-w-4xl text-3xl font-extrabold text-base-content md:text-5xl">
        {{ job_title }}
      </h1>
      {%- if summary != blank -%}
        <p class="mt-4 max-w-3xl text-base text-base-content/75 md:text-lg">{{ summary }}</p>
      {%- endif -%}
      <div class="mt-5 flex flex-wrap gap-2 text-sm text-base-content/75">
        {%- if location != blank -%}<span class="rounded-full bg-base-100 px-3 py-1">{{ location }}</span>{%- endif -%}
        {%- if employment_type != blank -%}<span class="rounded-full bg-base-100 px-3 py-1">{{ employment_type }}</span>{%- endif -%}
        {%- if workplace_mode != blank -%}<span class="rounded-full bg-primary/10 px-3 py-1 text-primary">{{ workplace_mode }}</span>{%- endif -%}
        {%- if salary != blank -%}<span class="rounded-full bg-base-100 px-3 py-1">{{ salary }}</span>{%- endif -%}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="space-y-6 lg:col-span-7 xl:col-span-8">
        {%- if page.settings.responsibilities != blank -%}
          <article class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
            <h2 class="text-xl font-bold text-base-content">{{ 'templates.page.responsibilities' | t }}</h2>
            <div class="ProseMirror mt-4 max-w-none text-base-content/85">
              {{ page.settings.responsibilities }}
            </div>
          </article>
        {%- endif -%}

        {%- if page.settings.requirements != blank -%}
          <article class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
            <h2 class="text-xl font-bold text-base-content">{{ 'templates.page.requirements' | t }}</h2>
            <div class="ProseMirror mt-4 max-w-none text-base-content/85">
              {{ page.settings.requirements }}
            </div>
          </article>
        {%- endif -%}

        <article class="rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
          <h2 class="text-xl font-bold text-base-content">{{ 'templates.page.job_description' | t }}</h2>
          <div class="ProseMirror mt-4 max-w-none text-base-content/85">
            {{ page.settings.content }}
          </div>
        </article>
      </div>

      <aside class="lg:col-span-5 xl:col-span-4">
        <div class="sticky top-24 space-y-6">
          <div class="rounded-2xl border border-base-300 bg-base-100 p-6">
            <a class="btn btn-primary w-full" href="{{ statics['apply'] }}?job_title={{ job_title }}&location={{ location }}&employment_type={{ employment_type }}&workplace_mode={{ workplace_mode }}&skill_tags={{ skill_tags_raw }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">
              {{ apply_label }}
            </a>
            <dl class="mt-6 space-y-3 text-sm">
              <div class="flex items-center justify-between gap-4">
                <dt class="text-base-content/70">{{ 'templates.page.posted' | t }}</dt>
                <dd class="font-semibold text-base-content">{{ posted_at | date: "%Y-%m-%d" }}</dd>
              </div>
              {%- if location != blank -%}
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-base-content/70">{{ 'templates.page.location' | t }}</dt>
                  <dd class="text-right font-semibold text-base-content">{{ location }}</dd>
                </div>
              {%- endif -%}
              {%- if salary != blank -%}
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-base-content/70">{{ 'templates.page.salary' | t }}</dt>
                  <dd class="text-right font-semibold text-base-content">{{ salary }}</dd>
                </div>
              {%- endif -%}
              {%- if employment_type != blank -%}
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-base-content/70">{{ 'templates.page.employment' | t }}</dt>
                  <dd class="text-right font-semibold text-base-content">{{ employment_type }}</dd>
                </div>
              {%- endif -%}
              {%- if workplace_mode != blank -%}
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-base-content/70">{{ 'templates.page.workplace' | t }}</dt>
                  <dd class="text-right font-semibold text-base-content">{{ workplace_mode }}</dd>
                </div>
              {%- endif -%}
            </dl>
          </div>

          {%- if skill_tags_raw != blank -%}
            <div class="rounded-2xl border border-base-300 bg-base-100 p-6">
              <h2 class="text-base font-bold text-base-content">{{ 'templates.page.skills' | t }}</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {%- for tag in skill_tags -%}
                  {%- assign tag_text = tag | strip -%}
                  {%- if tag_text != blank -%}
                    <span class="rounded-md bg-base-200 px-2.5 py-1 text-xs font-semibold text-base-content/85">{{ tag_text }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </aside>
  </section>

  <section class="bg-base-200/60 py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="mb-4 text-2xl font-extrabold text-base-content">{{ 'templates.page.related_jobs' | t }}</h2>
      <div class="space-y-4">
        {%- assign related_count = 0 -%}
        {%- for job in siblings -%}
          {%- if job.id != page.id and related_count < 4 -%}
            {%- assign related_count = related_count | plus: 1 -%}
            {%- assign sibling_title = job.ext_info.title | default: job.settings.title | default: job.link_text -%}
            {%- assign sibling_location = job.ext_info.location | default: job.settings.location -%}
            {%- assign sibling_employment_type = job.ext_info.employment_type | default: job.settings.employment_type -%}
            {%- assign sibling_posted_at = job.ext_info.date_posted | default: job.published_at | default: job.created_at -%}
            <article class="rounded-2xl border border-base-300 bg-base-100 p-5">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-base-content">
                    <a class="transition hover:text-primary" href="{{ job.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">{{ sibling_title }}</a>
                  </h3>
                  <div class="mt-2 flex flex-wrap gap-2 text-sm text-base-content/70">
                    {%- if sibling_location != blank -%}<span class="rounded-full bg-base-200 px-3 py-1">{{ sibling_location }}</span>{%- endif -%}
                    {%- if sibling_employment_type != blank -%}<span class="rounded-full bg-base-200 px-3 py-1">{{ sibling_employment_type }}</span>{%- endif -%}
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-xs text-base-content/60">{{ sibling_posted_at | date: "%b %d, %Y" }}</div>
                  <a class="btn btn-sm btn-outline mt-2" href="{{ job.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">{{ 'templates.page.view_role' | t }}</a>
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
        {%- if related_count == 0 -%}
          <div class="rounded-2xl border border-base-300 bg-base-100 p-6 text-sm text-base-content/70">{{ 'templates.page.no_related' | t }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
</main>

{% schema %}
  {
    "name": "t:schema.templates.page.name",
    "description": "t:schema.templates.page.description",
    "thumb_url": "images/theme/${lang}/page.png",
    "preview_image_urls": ["images/theme/${lang}/page.png"],
    "sub_page_templates": [],
    "settings": [
      { "type": "header", "content": "t:schema.templates.page.header_basic" },
      { "id": "title", "type": "text", "label": "t:schema.templates.page.settings.title.label"},
      { "id": "location", "type": "select", "label": "t:schema.templates.page.settings.location.label", "choices_from": "$site.location_options", "queryable": true, "info": "t:schema.templates.page.settings.location.info" },
      { "id": "employment_type", "type": "select", "label": "t:schema.templates.page.settings.employment_type.label", "choices_from": "$site.employment_type_options", "queryable": true, "info": "t:schema.templates.page.settings.employment_type.info" },
      { "id": "salary", "type": "select", "label": "t:schema.templates.page.settings.salary.label", "choices_from": "$site.salary_options", "queryable": true, "info": "t:schema.templates.page.settings.salary.info" },
      { "id": "workplace_mode", "type": "select", "label": "t:schema.templates.page.settings.workplace_mode.label", "default": "On-site", "queryable": true, "choices": [{"label": "t:schema.templates.page.settings.workplace_mode.choices.on_site", "value": "On-site"}, {"label": "t:schema.templates.page.settings.workplace_mode.choices.hybrid", "value": "Hybrid"}, {"label": "t:schema.templates.page.settings.workplace_mode.choices.remote", "value": "Remote"}] },
      { "id": "featured", "type": "checkbox", "label": "t:schema.templates.page.settings.featured.label", "default": false, "queryable": true },
      { "id": "skill_tags", "type": "textarea", "label": "t:schema.templates.page.settings.skill_tags.label", "queryable": true },
      { "type": "header", "content": "t:schema.templates.page.header_content" },
      { "id": "responsibilities", "type": "richtext", "label": "t:schema.templates.page.settings.responsibilities.label", "to_markdown": true },
      { "id": "requirements", "type": "richtext", "label": "t:schema.templates.page.settings.requirements.label", "to_markdown": true },
      { "id": "content", "type": "richtext", "label": "t:schema.templates.page.settings.content.label", "to_markdown": true }
    ]
  }
{% endschema %}

