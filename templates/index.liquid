{%- assign channels = site.pages['/'].children_in_list | order_by: '-published_at' -%}
{%- assign filter_keyword = params.keyword | default: '' | strip -%}
{%- assign filter_location = params.location | default: '' | strip -%}
{%- assign filter_salary = params.salary | default: '' | strip -%}
{%- assign filter_employment_type = params.employment_type | default: '' | strip -%}
{%- assign filter_experience_level = params.experience_level | default: '' | strip -%}

{% query jobs_all from site.pages['/'].pages_in_list %}
  {
    "where": {
      "and": {
        "template_name_eq": "page"
        {%- if filter_keyword != '' -%}
        ,"title_cont": "{{ filter_keyword }}"
        {%- endif -%}
        {%- if filter_location != '' -%}
        ,"settings.location_eq": "{{ filter_location }}"
        {%- endif -%}
        {%- if filter_salary != '' -%}
        ,"settings.salary_eq": "{{ filter_salary }}"
        {%- endif -%}
        {%- if filter_employment_type != '' -%}
        ,"settings.employment_type_eq": "{{ filter_employment_type }}"
        {%- endif -%}
        {%- if filter_experience_level != '' -%}
        ,"settings.experience_level_eq": "{{ filter_experience_level }}"
        {%- endif -%}
      }
    },
    "order_by": ["-published_at"]
  }
{% endquery %}

{%- assign location_options = site.settings.location_options | default: '' | newline_to_br | split: '<br />' -%}
{%- assign employment_type_options = site.settings.employment_type_options | default: '' | newline_to_br | split: '<br />' -%}
{%- assign hero_bg_url = page.settings.hero_bg_url | default: '' | strip -%}

<main class="grow">
  <section
    class="py-16 md:py-24 {% if hero_bg_url != blank %}bg-cover bg-center bg-no-repeat{% else %}bg-primary{% endif %}"
    {% if hero_bg_url != blank %}
      style="background-image: linear-gradient(to bottom right, hsl(var(--theme-color-primary) / 0.86), hsl(var(--theme-color-neutral) / 0.72)), url('{{ hero_bg_url | escape }}');"
    {% endif %}
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-primary-content md:text-6xl">
          {{ page.settings.hero_title | default: 'Find your next opportunity' }}
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base text-primary-content/80 md:text-lg">
          {{ page.settings.hero_description | default: 'Explore curated roles with transparent salary, role type, and hiring expectations.' }}
        </p>
      </div>
      <div class="mx-auto mt-10 max-w-5xl rounded-2xl border border-primary-content/20 bg-base-100/95 p-4 md:p-6">
        <form class="grid gap-3 md:grid-cols-5" method="get" action="{{ page.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">
          <label class="md:col-span-2">
            <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-base-content/70">Keyword</span>
            <input class="form-input" type="text" name="keyword" value="{{ filter_keyword | escape }}" placeholder="Role or skill">
          </label>
          <label>
            <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-base-content/70">Location</span>
            <select class="form-select" name="location">
              <option value="" {% if filter_location == blank %}selected{% endif %}>Any</option>
              {%- for v in location_options -%}
                {%- assign vv = v | strip -%}
                {%- if vv != blank -%}
                  <option value="{{ vv | escape }}" {% if filter_location == vv %}selected{% endif %}>{{ vv }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </label>
          <label>
            <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-base-content/70">Type</span>
            <select class="form-select" name="employment_type">
              <option value="" {% if filter_employment_type == blank %}selected{% endif %}>Any</option>
              {%- for v in employment_type_options -%}
                {%- assign vv = v | strip -%}
                {%- if vv != blank -%}
                  <option value="{{ vv | escape }}" {% if filter_employment_type == vv %}selected{% endif %}>{{ vv }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </label>
          <div class="flex items-end gap-2">
            <button type="submit" class="btn btn-primary flex-1">Search</button>
            <a class="btn btn-ghost" href="{{ page.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">Reset</a>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-extrabold text-base-content">Latest jobs</h2>
          <p class="mt-2 text-sm text-base-content/70">Browse opportunities by role type, compensation, and experience.</p>
        </div>
        {%- assign channels_count = channels | size -%}
        {%- if channels_count > 0 -%}
          <nav>
            <ul class="flex flex-wrap gap-2">
              {%- for ch in channels -%}
                <li>
                  <a class="inline-flex items-center rounded-full border border-base-300 bg-base-100 px-3 py-1.5 text-sm font-semibold text-base-content transition hover:border-primary/40 hover:text-primary" href="{{ ch.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">
                    {{ ch.link_text | default: ch.name }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      <div>
          {% paginate_tag jobs_all, as: 'jobs', per: 10 %}
            <div class="space-y-4">
              {%- for job in jobs -%}
                {%- assign job_title = job.ext_info.title | default: job.settings.title | default: job.link_text -%}
                {%- assign location = job.ext_info.location | default: job.settings.location -%}
                {%- assign salary = job.ext_info.salary | default: job.settings.salary -%}
                {%- assign employment_type = job.ext_info.employment_type | default: job.settings.employment_type -%}
                {%- assign experience_level = job.settings.experience_level | default: job.ext_info.experience_level -%}
                {%- assign posted_at = job.ext_info.date_posted | default: job.published_at | default: job.created_at -%}
                {%- assign apply_url = job.settings.apply_url | default: '/s/apply' -%}
                {%- assign skill_tags_raw = job.settings.skill_tags | default: '' -%}
                {%- assign skill_tags = skill_tags_raw | split: ',' -%}
                <article class="group relative rounded-2xl border border-base-300 bg-base-100 p-6 transition hover:border-primary/40 hover:shadow-md">
                  {%- if job.settings.featured -%}
                    <div class="absolute -top-2.5 right-4 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-primary-content">Featured</div>
                  {%- endif -%}
                  <div class="flex flex-wrap items-start justify-between gap-4">
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold text-base-content transition group-hover:text-primary">
                        <a href="{{ job.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">{{ job_title }}</a>
                      </h3>
                      <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-base-content/70">
                        {%- if location != blank -%}<span class="rounded-full bg-base-200 px-3 py-1">{{ location }}</span>{%- endif -%}
                        {%- if salary != blank -%}<span class="rounded-full bg-primary/10 px-3 py-1 text-primary">{{ salary }}</span>{%- endif -%}
                        {%- if employment_type != blank -%}<span class="rounded-full bg-base-200 px-3 py-1">{{ employment_type }}</span>{%- endif -%}
                        {%- if experience_level != blank -%}<span class="rounded-full bg-secondary/15 px-3 py-1 text-secondary">{{ experience_level }}</span>{%- endif -%}
                      </div>
                      {%- if skill_tags_raw != blank -%}
                        <div class="mt-3 flex flex-wrap gap-2">
                          {%- for tag in skill_tags limit: 4 -%}
                            {%- assign tag_text = tag | strip -%}
                            {%- if tag_text != blank -%}
                              <span class="rounded-md bg-base-200 px-2.5 py-1 text-xs font-medium text-base-content/80">{{ tag_text }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                    <div class="text-right">
                      <div class="text-xs text-base-content/60">{{ posted_at | date: "%b %d, %Y" }}</div>
                      <div class="mt-3 flex gap-2">
                        <a class="btn btn-sm btn-outline" href="{{ job.path }}" data-turbo-frame="main-content-frame" data-turbo-action="advance">View Details</a>
                      </div>
                    </div>
                  </div>
                </article>
              {%- else -%}
                <div class="rounded-2xl border border-base-300 bg-base-100 p-8 text-center text-base-content/70">No jobs found for the selected filters.</div>
              {%- endfor -%}
            </div>
            <div class="py-8">
              {% render 'paginate', paginate: paginate %}
            </div>
          {% endpaginate_tag %}
      </div>
    </div>
  </section>
</main>

{% schema %}
  {
    "name": "Jobs Index",
    "description": "HireHub-inspired jobs home layout",
    "thumb_url": "images/theme/preview-index.png",
    "preview_image_urls": ["images/theme/preview-index.png"],
    "sub_page_templates": ["channel"],
    "settings": [
      { "id": "hero_title", "type": "text", "label": "Hero title", "default": "Find your next opportunity" },
      { "id": "hero_description", "type": "textarea", "label": "Hero description", "default": "Explore curated roles with transparent salary, role type, and hiring expectations." },
      {
        "id": "hero_bg_url",
        "type": "image_picker",
        "ratio": "16:9",
        "width": 300,
        "label": "Hero background image (global)",
        "info": "Optional: used as the site-wide background image. Upload a wide image that fits the hero area.",
        "default": ""
      }
    ]
  }
{% endschema %}

