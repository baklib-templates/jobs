[
  {
    "name": "theme_info",
    "theme_name": "jobs",
    "theme_label": "jobs",
    "theme_description": "A professional employer-branding and recruiting portal with structured job schema, one-click publishing, online applications, and resume collection.",
    "theme_version": "0.0.1",
    "theme_syntax_version": "v2",
    "theme_scope": "cms",
    "theme_author": "Baklib",
    "theme_documentation_url": "https://help.baklib.cn/theme/jobs",
    "theme_support_url": "https://help.baklib.cn/theme/jobs",
    "theme_thumb_url": "images/theme/thumb.png",
    "theme_preview_images": [
      "images/theme/${lang}/cover.png",
      "images/theme/${lang}/index_poster.png",
      "images/theme/${lang}/page_poster.png"
    ],
    "theme_languages": [
      { "name": "简体中文", "value": "zh-CN" },
      { "name": "English", "value": "en" }
    ],
    "recommendations": {
      "color_schemas": {
        "baklib": {
          "name": "Baklib",
          "colors": {
            "--theme-color-primary": "#0F766E",
            "--theme-color-secondary": "#C2410C",
            "--theme-color-accent": "#0F172A",
            "--theme-color-info": "#60A5FA",
            "--theme-color-success": "#14B8A6",
            "--theme-color-warning": "#FDBA74"
          }
        },
        "fashion": {
          "name": "Fashion",
          "colors": {
            "--theme-color-primary": "#3D50E0",
            "--theme-color-secondary": "#E91E63",
            "--theme-color-accent": "#AAAAAA",
            "--theme-color-info": "#2196F3",
            "--theme-color-success": "#4CAF50",
            "--theme-color-warning": "#FFC107"
          }
        }
      }
    }
  },
  {
    "name": "Job Post Settings",
    "settings": [
      {
        "type": "header",
        "content": "Job field dropdown options (used by Job Post)"
      },
      {
        "id": "logo_url",
        "type": "image_picker",
        "label": "Logo",
        "info": "Logo displayed in the top navigation. Use a brand-consistent icon."
      },
      {
        "id": "company_name_options",
        "type": "textarea",
        "label": "Company options (one per line)",
        "info": "Company dropdown options for Job Post. One option per line.",
        "rows": 6,
        "default": "Acme Inc.\nMedium Inc.\nBeta Labs"
      },
      {
        "id": "location_options",
        "type": "textarea",
        "label": "Location options (one per line)",
        "info": "Location dropdown options for Job Post. One option per line.",
        "rows": 6,
        "default": "Remote\nShanghai\nLondon\nShenzhen"
      },
      {
        "id": "salary_options",
        "type": "textarea",
        "label": "Salary options (one per line)",
        "info": "Salary dropdown options for Job Post. One option per line.",
        "rows": 6,
        "default": "Negotiable\n$60K - $90K\n$75K - $100K\n$100K - $170K"
      },
      {
        "id": "employment_type_options",
        "type": "textarea",
        "label": "Employment type options (one per line)",
        "info": "Employment type dropdown options for Job Post. One option per line.",
        "rows": 6,
        "default": "Full-time\nPart-time\nInternship\nContract"
      }
    ]
  },
  {
    "name": "Apply Contact Settings",
    "settings": [
      {
        "type": "header",
        "content": "Apply page contact information"
      },
      {
        "id": "apply_contact_email_label",
        "type": "text",
        "label": "Apply contact email label",
        "default": "Email"
      },
      {
        "id": "apply_contact_email",
        "type": "text",
        "label": "Apply contact email",
        "default": "jobs@baklib.com"
      },
      {
        "id": "apply_contact_phone_label",
        "type": "text",
        "label": "Apply contact phone label",
        "default": "Phone"
      },
      {
        "id": "apply_contact_phone",
        "type": "text",
        "label": "Apply contact phone",
        "default": "+1-555-492-3847"
      },
      {
        "id": "apply_contact_office_label",
        "type": "text",
        "label": "Apply contact office label",
        "default": "Office"
      },
      {
        "id": "apply_contact_office_line1",
        "type": "text",
        "label": "Apply contact office line 1",
        "default": "200 Tech Boulevard"
      },
      {
        "id": "apply_contact_office_line2",
        "type": "text",
        "label": "Apply contact office line 2",
        "default": "San Francisco, CA 94105"
      },
      {
        "id": "apply_contact_hours_label",
        "type": "text",
        "label": "Apply contact business hours label",
        "default": "Business Hours"
      },
      {
        "id": "apply_contact_hours_line1",
        "type": "text",
        "label": "Apply contact business hours line 1",
        "default": "Mon - Fri: 9:00 AM - 6:00 PM PST"
      },
      {
        "id": "apply_contact_hours_line2",
        "type": "text",
        "label": "Apply contact business hours line 2",
        "default": "Sat - Sun: Closed"
      },
      {
        "id": "head_html",
        "type": "html",
        "label": "Custom head code",
        "rows": 8,
        "info": "place any head code like google analytics here."
      },
      {
        "id": "header_html",
        "type": "html",
        "label": "Header menu HTML",
        "rows": 8,
        "info": "Supports a list of <a> tags for desktop and mobile navigation.",
        "default": "preset:header_html"
      },
      {
        "id": "footer_html",
        "type": "html",
        "label": "Custom footer HTML",
        "rows": 8,
        "default": "preset:footer_html"
      }
    ]
  }
]

