{%- assign apply_contact_email_label = site.settings.apply_contact_email_label | default: 'Email' -%}
{%- assign apply_contact_email = site.settings.apply_contact_email | default: 'jobs@baklib.com' -%}
{%- assign apply_contact_phone_label = site.settings.apply_contact_phone_label | default: 'Phone' -%}
{%- assign apply_contact_phone = site.settings.apply_contact_phone | default: '+1-555-492-3847' -%}
{%- assign apply_contact_office_label = site.settings.apply_contact_office_label | default: 'Office' -%}
{%- assign apply_contact_office_line1 = site.settings.apply_contact_office_line1 | default: '200 Tech Boulevard' -%}
{%- assign apply_contact_office_line2 = site.settings.apply_contact_office_line2 | default: 'San Francisco, CA 94105' -%}
{%- assign apply_contact_hours_label = site.settings.apply_contact_hours_label | default: 'Business Hours' -%}
{%- assign apply_contact_hours_line1 = site.settings.apply_contact_hours_line1 | default: 'Mon - Fri: 9:00 AM - 6:00 PM PST' -%}
{%- assign apply_contact_hours_line2 = site.settings.apply_contact_hours_line2 | default: 'Sat - Sun: Closed' -%}
{%- assign apply_default_feedback_type = site.plugins.feedback.useful_types | first -%}
{%- assign apply_default_feedback_emoji = apply_default_feedback_type.emoji | default: '' -%}

<main
  class="min-h-[calc(100vh-80px)]"
  x-data="{
    formData: {
      name: '',
      contact: '',
      description: '',
      attachment: '',
      jobContext: ''
    },
    errors: {},
    isSubmitting: false,
    init() {
      const queryParams = new URLSearchParams(window.location.search)
      const fieldMappings = [
        ['job_title', 'Job Title'],
        ['location', 'Location'],
        ['employment_type', 'Employment Type'],
        ['experience_level', 'Experience Level'],
        ['workplace_mode', 'Workplace Mode'],
        ['department', 'Department'],
        ['skill_tags', 'Skill Tags']
      ]

      const lines = fieldMappings
        .map(([key, label]) => {
          const value = queryParams.get(key)
          return value ? `${label}: ${value}` : ''
        })
        .filter(Boolean)

      this.formData.jobContext = lines.join('\n')

      this.$nextTick(() => {
        const formEl = this.$refs.submitBtn?.form
        if (formEl) {
          formEl.setAttribute('data-turbo', 'false')
          formEl.setAttribute('data-turbo-frame', '_top')
        }
      })
    },
    submitForm() {
      this.errors = {}
      this.isSubmitting = true

      if (!this.formData.name) this.errors.name = 'Name is required.'
      if (!this.formData.contact) this.errors.contact = 'Contact (email or phone) is required.'
      if (!this.formData.description) this.errors.description = 'Description is required.'

      if (Object.keys(this.errors).length > 0) {
        this.isSubmitting = false
        return
      }

      let lines = []
      lines.push('[Jobs Apply]')
      if (this.formData.jobContext) lines.push('Position Details:\n' + this.formData.jobContext)
      if (this.formData.name) lines.push('Name: ' + this.formData.name)
      if (this.formData.contact) lines.push('Contact: ' + this.formData.contact)
      if (this.formData.description) lines.push('Description:\\n' + this.formData.description)
      if (this.formData.attachment) lines.push('Attachment: ' + this.formData.attachment)

      $refs.messageInput.value = lines.join('\\n')
      $refs.submitBtn.click()

      const jobContext = this.formData.jobContext
      this.formData = {
        name: '',
        contact: '',
        description: '',
        attachment: '',
        jobContext: jobContext
      }
      this.isSubmitting = false
    }
  }"
>
  <section class="bg-primary py-16 lg:py-24 text-primary-content">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h1 class="text-3xl font-bold sm:text-4xl lg:text-5xl">Apply for a Role</h1>
      <p class="mx-auto mt-4 max-w-2xl text-primary-content/80">
        Share your hiring details and submit your application request. Our team will follow up shortly.
      </p>
      <nav class="mt-6 flex items-center justify-center gap-2 text-sm text-primary-content/70" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-primary-content">Home</a>
        <span>/</span>
        <span class="text-primary-content">Apply</span>
      </nav>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <h2 class="text-2xl font-bold text-base-content">Submit Application Details</h2>
          <p class="mt-2 text-base-content/70">
            Complete the form below and we will contact you once your job submission is reviewed.
          </p>

          {% form_tag 'feedback', page: page %}
            <input type="hidden" name="{{ form.feedback_message_field_name }}" x-ref="messageInput">
            <input type="hidden" name="{{ form.feedback_emoji_field_name }}" value="{{ apply_default_feedback_emoji | escape_once }}">
            <button type="submit" x-ref="submitBtn" class="hidden"></button>

            <div class="mt-8 space-y-6 rounded-box border border-base-300 bg-base-100 p-6 sm:p-8">
              <div>
                <div class="mb-3 text-base font-extrabold text-base-content"><span class="text-primary">0.</span> Position details from URL</div>
                <div>
                  <label class="mb-1 block text-sm font-semibold text-base-content" for="job-context">Job metadata</label>
                  <textarea id="job-context" class="form-textarea" rows="6" x-model="formData.jobContext" readonly placeholder="No position parameters were provided in the URL."></textarea>
                </div>
              </div>
              <div>
                <div class="mb-3 text-base font-extrabold text-base-content"><span class="text-primary">1.</span> Your details</div>
                <div class="space-y-4">
                  <div>
                    <label class="mb-1 block text-sm font-semibold text-base-content" for="name">Name</label>
                    <input id="name" class="form-input" type="text" x-model="formData.name" placeholder="Your name">
                    <p x-show="errors.name" x-text="errors.name" class="mt-1 text-xs text-error"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-semibold text-base-content" for="contact">Contact (email or phone)</label>
                    <input id="contact" class="form-input" type="text" x-model="formData.contact" placeholder="name@example.com / +1 555 123 4567">
                    <p x-show="errors.contact" x-text="errors.contact" class="mt-1 text-xs text-error"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-semibold text-base-content" for="description">Description (short profile)</label>
                    <textarea id="description" class="form-textarea" rows="4" x-model="formData.description" placeholder="Briefly introduce yourself"></textarea>
                    <p x-show="errors.description" x-text="errors.description" class="mt-1 text-xs text-error"></p>
                  </div>
                  <div>
                    <label class="mb-1 block text-sm font-semibold text-base-content" for="attachment">Attachment (resume link or portfolio)</label>
                    <input id="attachment" class="form-input" type="url" x-model="formData.attachment" placeholder="https://your-portfolio.example.com">
                  </div>
                </div>
              </div>

              <div class="pt-2">
                <button
                  type="button"
                  class="btn btn-secondary w-full"
                  @click="submitForm"
                  :disabled="isSubmitting"
                >
                  <span x-show="!isSubmitting">Submit</span>
                  <span x-show="isSubmitting">Submitting...</span>
                </button>
                <p class="mt-3 text-center text-xs text-base-content/60">Your request will be sent through the existing application flow.</p>
              </div>
            </div>
          {% endform_tag %}
        </div>

        <aside class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-base-content">Get in Touch</h2>
          <p class="mt-2 text-base-content/70">
            Need help before applying? Reach out and we will guide your submission.
          </p>
          <div class="mt-8 space-y-6 rounded-box border border-base-300 bg-base-100 p-6 sm:p-8">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-base-content">{{ apply_contact_email_label }}</h3>
                <a href="mailto:{{ apply_contact_email }}" class="text-base-content/70 transition-colors hover:text-primary">{{ apply_contact_email }}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-base-content">{{ apply_contact_phone_label }}</h3>
                <a href="tel:{{ apply_contact_phone }}" class="text-base-content/70 transition-colors hover:text-primary">{{ apply_contact_phone }}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-base-content">{{ apply_contact_office_label }}</h3>
                <p class="text-base-content/70">{{ apply_contact_office_line1 }}</p>
                <p class="text-base-content/70">{{ apply_contact_office_line2 }}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-base-content">{{ apply_contact_hours_label }}</h3>
                <p class="text-base-content/70">{{ apply_contact_hours_line1 }}</p>
                <p class="text-base-content/70">{{ apply_contact_hours_line2 }}</p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</main>

